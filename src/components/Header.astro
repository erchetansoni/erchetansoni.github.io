---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";

const { features } = config;
const locale = Astro.currentLocale ?? config.site.lang;

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="fixed z-50 top-3 left-6 px-4 py-2 text-xs font-semibold rounded-full bg-paper-deep text-ink border border-line shadow-md -translate-y-20 focus:translate-y-0 transition-transform"
>
  Skip to content
</a>

<header class="sticky top-3 z-50 w-full px-4 sm:px-6">
  <div class="glass-header max-w-5xl mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between">
    <!-- Brand Signature -->
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="group flex items-center gap-2.5 focus:outline-none"
      title="Chetan Soni - Home"
    >
      <span class="size-8 rounded-full overflow-hidden border border-line bg-violet/15 flex items-center justify-center group-hover:scale-105 group-hover:border-violet/40 transition-all shrink-0 shadow-xs">
        <img
          src={config.site.avatar}
          alt={config.site.author}
          width="32"
          height="32"
          class="size-full object-cover"
          loading="eager"
          decoding="async"
        />
      </span>
      <div class="flex flex-col">
        <span class="font-bold text-sm tracking-tight text-ink group-hover:text-violet transition-colors">
          Chetan Soni
        </span>
        <span class="text-[10px] uppercase font-bold tracking-wider text-muted hidden sm:inline">
          Cloud &amp; DevOps
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class={`px-3 py-1.5 rounded-full transition-colors flex items-center gap-1.5 ${
          currentPath === "" || currentPath === "/"
            ? "bg-violet/15 text-violet font-semibold border border-violet/25"
            : "text-muted hover:text-ink hover:bg-paper-deep/60"
        }`}
      >
        <span>Home</span>
      </a>

      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class={`px-3 py-1.5 rounded-full transition-colors flex items-center gap-1.5 ${
          isActive("/posts")
            ? "bg-violet/15 text-violet font-semibold border border-violet/25"
            : "text-muted hover:text-ink hover:bg-paper-deep/60"
        }`}
      >
        <span class="text-[10px] font-mono text-muted">01</span>
        <span>Articles</span>
      </a>

      <a
        href={getRelativeLocaleUrl(locale, "projects")}
        class={`px-3 py-1.5 rounded-full transition-colors flex items-center gap-1.5 ${
          isActive("/projects")
            ? "bg-violet/15 text-violet font-semibold border border-violet/25"
            : "text-muted hover:text-ink hover:bg-paper-deep/60"
        }`}
      >
        <span class="text-[10px] font-mono text-muted">02</span>
        <span>Projects</span>
      </a>

      <a
        href={getRelativeLocaleUrl(locale, "categories")}
        class={`px-3 py-1.5 rounded-full transition-colors flex items-center gap-1.5 ${
          isActive("/categories")
            ? "bg-violet/15 text-violet font-semibold border border-violet/25"
            : "text-muted hover:text-ink hover:bg-paper-deep/60"
        }`}
      >
        <span class="text-[10px] font-mono text-muted">03</span>
        <span>Topics</span>
      </a>

      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class={`px-3 py-1.5 rounded-full transition-colors flex items-center gap-1.5 ${
          isActive("/about")
            ? "bg-violet/15 text-violet font-semibold border border-violet/25"
            : "text-muted hover:text-ink hover:bg-paper-deep/60"
        }`}
      >
        <span class="text-[10px] font-mono text-muted">04</span>
        <span>About</span>
      </a>
    </nav>

    <!-- Utility Actions -->
    <div class="flex items-center gap-1 sm:gap-2">
      {
        features.search !== false && (
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            class="size-8 rounded-full flex items-center justify-center text-muted hover:text-ink hover:bg-paper-deep transition-colors"
            title="Search articles"
            aria-label="Search"
          >
            <IconSearch class="size-4" />
          </a>
        )
      }

      <a
        href={getRelativeLocaleUrl(locale, "rss.xml")}
        class="size-8 rounded-full hidden sm:flex items-center justify-center text-muted hover:text-ink hover:bg-paper-deep transition-colors"
        title="RSS Feed"
        aria-label="RSS Feed"
      >
        <IconRss class="size-4" />
      </a>

      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="size-8 rounded-full flex items-center justify-center text-muted hover:text-ink hover:bg-paper-deep transition-colors relative"
            title="Toggle theme"
            aria-label="auto"
          >
            <IconMoon class="size-4 transition-all scale-100 rotate-0 dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="size-4 absolute transition-all scale-0 rotate-90 dark:scale-100 dark:rotate-0" />
          </button>
        )
      }

      <a
        href="https://calendar.app.google/umYxcjewLfQ1PRwJ9"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-violet text-white shadow-sm hover:opacity-90 hover:shadow transition-all ml-1"
      >
        <span>Let's Talk</span>
        <span class="text-xs">↗</span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button
        id="menu-btn"
        class="p-1.5 text-muted hover:text-ink md:hidden focus:outline-none"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <IconMenuDeep id="menu-icon" class="size-5" />
        <IconX id="close-icon" class="size-5 hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden max-w-5xl mx-auto mt-2 p-4 rounded-2xl glass-header bg-paper/95 border border-line shadow-xl flex-col gap-2 text-sm"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="px-3 py-2 rounded-xl text-ink font-medium hover:bg-paper-deep transition-colors"
    >
      Home
    </a>
    <a
      href={getRelativeLocaleUrl(locale, "posts")}
      class="px-3 py-2 rounded-xl text-ink font-medium hover:bg-paper-deep transition-colors flex items-center justify-between"
    >
      <span>Articles</span>
      <span class="text-xs font-mono text-muted">01</span>
    </a>
    <a
      href={getRelativeLocaleUrl(locale, "projects")}
      class="px-3 py-2 rounded-xl text-ink font-medium hover:bg-paper-deep transition-colors flex items-center justify-between"
    >
      <span>Projects</span>
      <span class="text-xs font-mono text-muted">02</span>
    </a>
    <a
      href={getRelativeLocaleUrl(locale, "categories")}
      class="px-3 py-2 rounded-xl text-ink font-medium hover:bg-paper-deep transition-colors flex items-center justify-between"
    >
      <span>Topics</span>
      <span class="text-xs font-mono text-muted">03</span>
    </a>
    <a
      href={getRelativeLocaleUrl(locale, "about")}
      class="px-3 py-2 rounded-xl text-ink font-medium hover:bg-paper-deep transition-colors flex items-center justify-between"
    >
      <span>About</span>
      <span class="text-xs font-mono text-muted">04</span>
    </a>
    <a
      href="https://calendar.app.google/umYxcjewLfQ1PRwJ9"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 text-center py-2.5 px-4 rounded-full text-xs font-semibold bg-violet text-white shadow"
    >
      Book a Conversation ↗
    </a>
  </div>
</header>

<script>
  function setupHeader() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const mobileMenu = document.querySelector("#mobile-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !mobileMenu || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
      mobileMenu.classList.toggle("hidden");
      mobileMenu.classList.toggle("flex");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  setupHeader();
  document.addEventListener("astro:after-swap", setupHeader);
</script>
