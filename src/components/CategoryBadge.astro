---
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = {
  category: string;
  size?: "sm" | "base";
  count?: number;
};

const { category, size = "sm", count } = Astro.props;
const slug = slugifyStr(category);
const locale = Astro.currentLocale ?? config.site.lang;
---

<a
  href={getRelativeLocaleUrl(locale, `categories/${slug}/`)}
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-medium transition-colors",
    "bg-accent/10 text-accent hover:bg-accent hover:text-accent-foreground dark:bg-accent/20",
    "border border-accent/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent",
    { "text-xs": size === "sm" },
    { "text-sm": size === "base" },
  ]}
>
  <span class="size-1.5 rounded-full bg-accent"></span>
  <span>{category}</span>
  {count !== undefined && <span class="opacity-75 text-[0.85em]">({count})</span>}
</a>
