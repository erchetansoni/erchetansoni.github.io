---
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = {
  category: string;
  size?: "sm" | "base";
  count?: number;
};

const { category, size = "sm", count } = Astro.props;
const slug = slugifyStr(category);
const locale = Astro.currentLocale ?? config.site.lang;
---

<a
  href={getRelativeLocaleUrl(locale, `categories/${slug}/`)}
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full font-semibold transition-all duration-150",
    "bg-violet/10 text-violet hover:bg-violet hover:text-white border border-violet/25 shadow-xs",
    size === "sm" ? "px-2.5 py-0.5 text-xs" : "px-3.5 py-1 text-sm",
  ]}
>
  <span class="size-1.5 rounded-full bg-violet"></span>
  <span>{category}</span>
  {count !== undefined && <span class="opacity-75 text-[0.85em]">({count})</span>}
</a>
