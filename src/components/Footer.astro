---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["shell mt-auto pt-12 pb-8 border-t border-line text-xs text-muted", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pb-6">
    <!-- Brand Info -->
    <div class="flex items-center gap-3">
      <span class="size-8 rounded-full bg-violet/15 text-violet flex items-center justify-center font-bold text-xs border border-violet/30">
        CS
      </span>
      <div>
        <p class="font-bold text-ink text-sm">Chetan Soni</p>
        <p class="text-[11px] text-muted">Cloud &amp; DevOps Engineering · Evidence-first systems</p>
      </div>
    </div>

    <!-- Quick Footer Links -->
    <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-medium">
      <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-violet transition-colors">Home</a>
      <a href={getRelativeLocaleUrl(locale, "posts")} class="hover:text-violet transition-colors">Articles</a>
      <a href={getRelativeLocaleUrl(locale, "projects")} class="hover:text-violet transition-colors">Projects</a>
      <a href={getRelativeLocaleUrl(locale, "categories")} class="hover:text-violet transition-colors">Topics</a>
      <a href={getRelativeLocaleUrl(locale, "about")} class="hover:text-violet transition-colors">About</a>
      <a href="/resume/CHETAN%20SONI%20Resume%20DevOps.pdf" download class="hover:text-violet transition-colors">Résumé</a>
    </nav>
  </div>

  <div class="pt-6 border-t border-line/60 flex flex-col sm:flex-row items-center justify-between gap-4">
    <Socials />

    <div class="flex items-center gap-2 text-center sm:text-right">
      <span>Copyright &#169; {currentYear}</span>
      <span aria-hidden="true">&bull;</span>
      <span>All rights reserved.</span>
    </div>
  </div>
</footer>
