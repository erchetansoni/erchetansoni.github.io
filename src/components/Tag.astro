---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li class="inline-block list-none">
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "inline-flex items-center gap-1 rounded-full border border-line bg-paper-deep/60 font-medium text-ink transition-all hover:border-violet hover:text-violet hover:bg-paper-light shadow-xs",
      { "px-2.5 py-1 text-xs": size === "sm" },
      { "px-3.5 py-1.5 text-sm": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "text-muted opacity-80",
        { "size-3.5": size === "sm" },
        { "size-4": size === "lg" },
      ]}
    />
    <span>{tagName}</span>
  </a>
</li>
