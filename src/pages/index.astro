---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import CloudTelemetryWidget from "@/components/CloudTelemetryWidget.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const displayPosts = (featuredPosts.length > 0 ? featuredPosts : sortedPosts).slice(0, 3);

const projects = (await getCollection("projects"))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" data-home-path={homePath} class="shell my-6 space-y-24">
    <!-- HERO SECTION -->
    <section id="hero" class="pt-6 sm:pt-12 pb-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Engineer Profile Introduction -->
          <div class="flex items-center gap-4">
            <div class="relative group shrink-0">
              <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-violet via-teal to-violet opacity-60 blur-xs group-hover:opacity-100 transition-opacity"></div>
              <img
                src={config.site.avatar}
                alt={`${config.site.author} - Lead DevOps Engineer`}
                width="80"
                height="80"
                class="relative size-16 sm:size-20 rounded-2xl object-cover border-2 border-line bg-paper-deep shadow-md group-hover:scale-[1.03] transition-transform"
                loading="eager"
                decoding="async"
              />
              <span
                class="absolute -bottom-1 -right-1 size-3.5 sm:size-4 rounded-full bg-emerald-500 border-2 border-paper"
                title="Available for Cloud Leadership"
              ></span>
            </div>

            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xl sm:text-2xl font-extrabold tracking-tight text-ink">Chetan Soni</span>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-violet/10 text-violet border border-violet/25">
                  Lead DevOps Engineer
                </span>
              </div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-line bg-paper-deep text-xs font-medium text-ink">
                <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Available for Leadership · Bhopal/Ahmedabad/Pune/Bangalore/Delhi</span>
              </div>
            </div>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-[1.1]">
            Architecting resilient cloud platforms.<br />
            <span class="text-ink-soft">Production Kubernetes.</span><br />
            <em class="font-serif italic font-normal text-violet">Evidence-first delivery.</em>
          </h1>

          <p class="text-base sm:text-lg text-muted max-w-xl leading-relaxed">
            Lead DevOps Engineer &amp; Cloud Platform Specialist. Architecting zero-trust multi-cloud platforms on AWS &amp; Kubernetes with automated GitOps delivery, enterprise observability, and cloud cost governance.
          </p>

          <!-- Hero Actions -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a href="#work" class="btn-primary">
              <span>Explore My Work</span>
              <span>&darr;</span>
            </a>

            <a
              href="/resume/CHETAN%20SONI%20Resume%20DevOps.pdf"
              download
              class="btn-ghost"
              title="Download Résumé"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Résumé</span>
            </a>

            <a
              href="https://calendar.app.google/umYxcjewLfQ1PRwJ9"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Schedule Call ↗</span>
            </a>
          </div>
        </div>

        <!-- Hero Visual: Cloud Telemetry Widget -->
        <div class="lg:col-span-5">
          <CloudTelemetryWidget />
        </div>
      </div>
    </section>

    <!-- PROOF POINTS BAR (LATENTFOLIO SIGNATURE) -->
    <section class="border-y border-line py-8" aria-label="Selected engineering outcomes">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="proof-item">
          <strong>40%</strong>
          <span>Cloud Cost Reduction</span>
        </div>
        <div class="proof-item">
          <strong class="text-teal">99.99%</strong>
          <span>Multi-Region Uptime</span>
        </div>
        <div class="proof-item">
          <strong class="text-orange">85%</strong>
          <span>Faster CI/CD Deployments</span>
        </div>
        <div class="proof-item">
          <strong>15+</strong>
          <span>Production K8s Clusters</span>
        </div>
      </div>
    </section>

    <!-- SELECTED WORK / CASE STUDIES SECTION (#work) -->
    <section id="work" class="scroll-mt-24 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="section-kicker">01 / Selected Work</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink mt-2">
            Systems with <em class="font-serif italic font-normal text-violet">receipts.</em>
          </h2>
          <p class="text-sm sm:text-base text-muted max-w-xl mt-2">
            A focused set of infrastructure and platform systems explained through the technical problem, engineering decisions, and concrete outcomes.
          </p>
        </div>
        <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class="btn-ghost text-xs self-start sm:self-auto"
        >
          <span>All 8 Projects &rarr;</span>
        </a>
      </div>

      <!-- Bento Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((p, idx) => {
          const accents = ["accent-violet", "accent-teal", "accent-orange", "accent-amber"];
          const accentClass = accents[idx % accents.length];
          return (
            <article class={`bento-card ${accentClass} flex flex-col justify-between`}>
              <div class="space-y-3">
                <div class="flex items-center justify-between text-xs font-mono">
                  <span class="font-bold text-violet">0{idx + 1}</span>
                  <span class="pill-badge">{p.data.category}</span>
                </div>

                <h3 class="text-xl font-bold text-ink">
                  {p.data.title}
                </h3>

                <p class="text-sm text-muted line-clamp-3 leading-relaxed">
                  {p.data.description}
                </p>

                <!-- Tech Badges -->
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {p.data.tech.slice(0, 4).map((tech: string) => (
                    <span class="px-2 py-0.5 rounded-md bg-paper border border-line text-[11px] font-mono text-muted">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Outcome Highlight & Links -->
              <div class="mt-5 pt-3 border-t border-line/60 flex items-center justify-between text-xs">
                {p.data.github ? (
                  <a
                    href={p.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-violet hover:underline inline-flex items-center gap-1"
                  >
                    <span>View GitHub Repository</span>
                    <span>↗</span>
                  </a>
                ) : (
                  <span class="text-muted">Enterprise Production Deployment</span>
                )}
                {p.data.link && (
                  <a
                    href={p.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-teal hover:underline inline-flex items-center gap-1"
                  >
                    <span>Live Preview</span>
                    <span>↗</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- DEPTH ACROSS THE STACK (EXPERTISE SECTION) -->
    <section id="skills" class="scroll-mt-24 space-y-8">
      <div>
        <span class="section-kicker">02 / What I Do</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink mt-2">
          Depth across <em class="font-serif italic font-normal text-violet">the whole cloud stack.</em>
        </h2>
        <p class="text-sm sm:text-base text-muted max-w-xl mt-2">
          Hands-on technical leadership bridging cloud reliability, infrastructure automation, security compliance, and developer productivity.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- 01 Cloud Architecture -->
        <div class="bento-card space-y-3">
          <span class="text-xs font-mono font-bold text-violet">01</span>
          <h3 class="text-lg font-bold text-ink">Cloud Architecture</h3>
          <p class="text-xs text-muted leading-relaxed">
            Multi-region high-availability on AWS &amp; hybrid clouds. VPC peering, Transit Gateways, FinOps cost governance, and Disaster Recovery.
          </p>
          <div class="flex flex-wrap gap-1 pt-2">
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">AWS</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">VPC / TGW</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">FinOps</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">Route53</span>
          </div>
        </div>

        <!-- 02 Kubernetes -->
        <div class="bento-card space-y-3">
          <span class="text-xs font-mono font-bold text-teal">02</span>
          <h3 class="text-lg font-bold text-ink">Kubernetes &amp; Mesh</h3>
          <p class="text-xs text-muted leading-relaxed">
            Enterprise cluster lifecycle on EKS, GKE, and AKS. Istio service mesh, Helm chart packaging, KEDA event scaling, and cluster autoscaling.
          </p>
          <div class="flex flex-wrap gap-1 pt-2">
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">EKS / GKE</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">Helm</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">Istio</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">KEDA</span>
          </div>
        </div>

        <!-- 03 GitOps & CI/CD -->
        <div class="bento-card space-y-3">
          <span class="text-xs font-mono font-bold text-orange">03</span>
          <h3 class="text-lg font-bold text-ink">GitOps &amp; CI/CD</h3>
          <p class="text-xs text-muted leading-relaxed">
            Continuous delivery with ArgoCD and GitHub Actions. Automated blue/green rollouts, preview environments, and rapid build pipelines.
          </p>
          <div class="flex flex-wrap gap-1 pt-2">
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">ArgoCD</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">GitHub Actions</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">GitLab CI</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">Kaniko</span>
          </div>
        </div>

        <!-- 04 DevSecOps & IaC -->
        <div class="bento-card space-y-3">
          <span class="text-xs font-mono font-bold text-amber">04</span>
          <h3 class="text-lg font-bold text-ink">Zero-Trust IaC</h3>
          <p class="text-xs text-muted leading-relaxed">
            Repeatable infrastructure with Terraform &amp; Terragrunt. Automated vulnerability scanning with Trivy, HashiCorp Vault secrets, and IAM least-privilege.
          </p>
          <div class="flex flex-wrap gap-1 pt-2">
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">Terraform</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">Vault</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">Trivy</span>
            <span class="px-2 py-0.5 rounded bg-paper text-[11px] font-mono text-muted">IAM</span>
          </div>
        </div>
      </div>
    </section>

    <!-- TECHNICAL WRITING / ARTICLES SECTION (FREECODECAMP / DEVOPS.COM INSPIRATION) -->
    <section id="writing" class="scroll-mt-24 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="section-kicker">03 / Technical Writing</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink mt-2">
            Field notes on <em class="font-serif italic font-normal text-violet">production systems.</em>
          </h2>
          <p class="text-sm sm:text-base text-muted max-w-xl mt-2">
            Deep-dive tutorials and architecture breakdowns on Kubernetes, multi-cloud resilience, infrastructure as code, and automated delivery.
          </p>
        </div>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="btn-ghost text-xs self-start sm:self-auto"
        >
          <span>Explore All Articles &rarr;</span>
        </a>
      </div>

      <!-- Articles list -->
      <ul class="space-y-4">
        {displayPosts.map(data => (
          <Card variant="h3" {...data} />
        ))}
      </ul>
    </section>

    <!-- CAREER JOURNEY SECTION (#experience, #about) -->
    <section id="experience" class="scroll-mt-24 space-y-8">
      <div>
        <span class="section-kicker">04 / Proven Experience</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink mt-2">
          Career <em class="font-serif italic font-normal text-violet">progression &amp; leadership.</em>
        </h2>
        <p class="text-sm sm:text-base text-muted max-w-xl mt-2">
          Over 9+ years of engineering experience delivering mission-critical platforms, automating pipelines, and mentoring high-velocity teams.
        </p>
      </div>

      <!-- Timeline -->
      <div class="space-y-6 relative border-l-2 border-line pl-6 sm:pl-8 ml-3 sm:ml-4">
        <!-- Role 1 -->
        <div class="relative space-y-2">
          <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 size-4 rounded-full bg-violet border-4 border-paper"></span>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-lg font-bold text-ink">Lead DevOps Engineer</h3>
            <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full bg-violet/10 text-violet">
              2021 — Present
            </span>
          </div>
          <p class="text-sm font-semibold text-muted">Synechron Technologies</p>
          <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
            Lead the cloud platform engineering team responsible for multi-cloud Kubernetes infrastructure on AWS (EKS) and automated GitOps workflows via ArgoCD. Reduced deployment failure rates to near zero while achieving 40% FinOps cloud cost savings.
          </p>
        </div>

        <!-- Role 2 -->
        <div class="relative space-y-2">
          <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 size-4 rounded-full bg-teal border-4 border-paper"></span>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-lg font-bold text-ink">Senior Software Engineer (DevOps)</h3>
            <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full bg-teal/10 text-teal">
              2017 — 2021
            </span>
          </div>
          <p class="text-sm font-semibold text-muted">Bitwise Solutions</p>
          <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
            Engineered automated CI/CD release pipelines and containerized core microservices into Kubernetes. Implemented Terraform IaC standards across staging and production environments.
          </p>
        </div>

        <!-- Role 3 -->
        <div class="relative space-y-2">
          <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 size-4 rounded-full bg-orange border-4 border-paper"></span>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-lg font-bold text-ink">Junior Web &amp; System Administrator</h3>
            <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full bg-orange/10 text-orange">
              2015 — 2017
            </span>
          </div>
          <p class="text-sm font-semibold text-muted">Web-D-School</p>
          <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
            Managed Linux infrastructure, configured Nginx web servers, managed DNS records, and automated backup operations.
          </p>
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION / CONTACT SECTION (#contact) -->
    <section id="contact" class="scroll-mt-24">
      <div class="bento-card accent-violet p-8 sm:p-12 text-center space-y-6">
        <div class="flex justify-center -mb-2">
          <div class="relative group">
            <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-violet to-teal opacity-60 blur-xs group-hover:opacity-100 transition-opacity"></div>
            <img
              src={config.site.avatar}
              alt={config.site.author}
              width="80"
              height="80"
              class="relative size-18 sm:size-20 rounded-full object-cover border-2 border-line bg-paper shadow-lg group-hover:scale-105 transition-transform"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute bottom-0.5 right-0.5 size-4 rounded-full bg-emerald-500 border-2 border-paper" title="Active & Available"></span>
          </div>
        </div>

        <span class="section-kicker">Let's Connect</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink">
          Let's build something <em class="font-serif italic font-normal text-violet">worth shipping.</em>
        </h2>
        <p class="text-sm sm:text-base text-muted max-w-xl mx-auto leading-relaxed">
          I'm open to Lead / Staff DevOps &amp; Cloud Platform roles, consulting engagements, and technical collaborations. Let's discuss your architecture challenges.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="mailto:ErChetanSoni1@gmail.com"
            class="btn-primary"
          >
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>ErChetanSoni1@gmail.com</span>
          </a>

          <a
            href="https://www.linkedin.com/in/sonichetan/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
          >
            <span>LinkedIn ↗</span>
          </a>

          <a
            href="https://github.com/ErChetanSoni"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
          >
            <span>GitHub ↗</span>
          </a>

          <a
            href="https://t.me/ErChetanSoni"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
            title="Chat with @ErChetanSoni on Telegram"
          >
            <span>Telegram (@ErChetanSoni) ↗</span>
          </a>

          <a
            href="https://calendar.app.google/umYxcjewLfQ1PRwJ9"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
          >
            <span>Schedule Meeting ↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Anchors for legacy backwards compatibility -->
    <div id="about" class="sr-only">About section anchor</div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
