---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const projects = (await getCollection("projects"))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- Hero / Profile Section -->
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Lead DevOps & Cloud Platform Specialist</span>
          </div>
          <h1 class="my-3 text-3xl font-bold tracking-tight sm:my-4 sm:text-5xl">
            Hi, I'm <span class="text-accent">Chetan Soni</span>
          </h1>
          <p class="max-w-2xl text-base text-muted-foreground sm:text-lg leading-relaxed">
            Architecting scalable multi-cloud solutions, managing production Kubernetes clusters (EKS, GKE, AKS), automating zero-trust infrastructure with Terraform, and advancing platform engineering with GitOps.
          </p>
        </div>
      </div>

      <!-- Quick Action Links -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-foreground shadow-sm hover:opacity-90 transition-opacity"
        >
          Read Blog
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class="rounded-md border border-border bg-background px-4 py-2 text-sm font-semibold hover:border-accent hover:text-accent transition-colors"
        >
          Explore Projects
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="rounded-md border border-border bg-background px-4 py-2 text-sm font-semibold hover:border-accent hover:text-accent transition-colors"
        >
          About Me
        </a>
        <a
          href="/resume/CHETAN%20SONI%20Resume%20DevOps.pdf"
          download
          class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-3.5 py-2 text-sm font-medium text-muted-foreground hover:border-accent hover:text-accent transition-colors"
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Resume</span>
        </a>
        <a
          href="https://calendar.app.google/umYxcjewLfQ1PRwJ9"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-3.5 py-2 text-sm font-medium text-muted-foreground hover:border-accent hover:text-accent transition-colors"
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Book a Meeting</span>
        </a>
      </div>

      <!-- Social Links Bar -->
      {
        socials.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center gap-2 pt-4 border-t border-dashed border-border/60">
            <span class="text-xs font-medium text-muted-foreground">Connect:</span>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- Anchors for legacy backwards compatibility -->
    <div id="about" class="sr-only">About section anchor</div>
    <div id="skills" class="sr-only">Skills section anchor</div>
    <div id="experience" class="sr-only">Experience section anchor</div>
    <div id="contact" class="sr-only">Contact section anchor</div>

    <!-- Featured Articles -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-b pt-10 pb-6">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold tracking-wide sm:text-2xl">
              Featured Articles
            </h2>
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class="text-xs font-medium text-accent hover:underline sm:text-sm"
            >
              View all &rarr;
            </a>
          </div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Featured Projects Preview -->
    {
      projects.length > 0 && (
        <section id="projects" class="border-border border-b pt-10 pb-8">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-xl font-bold tracking-wide sm:text-2xl">
                Featured Projects
              </h2>
              <p class="text-sm text-muted-foreground mt-0.5">
                Selected open-source infrastructure and tooling
              </p>
            </div>
            <a
              href={getRelativeLocaleUrl(locale, "projects")}
              class="text-xs font-semibold text-accent hover:underline sm:text-sm"
            >
              All projects &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {projects.map(p => (
              <div class="rounded-lg border border-border bg-background/50 p-4 transition-all hover:border-accent/60">
                <div class="flex items-center justify-between">
                  <span class="rounded bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                    {p.data.category}
                  </span>
                  {p.data.github && (
                    <a
                      href={p.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs font-semibold text-accent hover:underline"
                    >
                      GitHub &rarr;
                    </a>
                  )}
                </div>
                <h3 class="mt-2 text-base font-bold text-foreground">
                  {p.data.title}
                </h3>
                <p class="mt-1 text-xs text-muted-foreground line-clamp-2">
                  {p.data.description}
                </p>
                <div class="mt-3 flex flex-wrap gap-1">
                  {p.data.tech.slice(0, 3).map((tech: string) => (
                    <span class="rounded bg-muted px-1.5 py-0.5 text-[11px] font-mono text-muted-foreground">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Recent Articles -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <h2 class="text-xl font-bold tracking-wide sm:text-2xl">
            Recent Posts
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
