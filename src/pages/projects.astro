---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const rawProjects = await getCollection("projects");
const projects = rawProjects.sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const categories = ["All", ...new Set(projects.map(p => p.data.category))];
---

<Layout title={`Featured Projects | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Projects"
    pageDesc="Open-source infrastructure, automation tools, and DevOps architectural blueprints."
  >
    <!-- Category filter buttons -->
    <div class="mt-6 flex flex-wrap gap-2" id="project-filters">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            class:list={[
              "filter-btn rounded-md px-3.5 py-1.5 text-sm font-medium transition-colors border",
              idx === 0
                ? "active bg-accent text-accent-foreground border-accent"
                : "border-border hover:bg-muted text-muted-foreground",
            ]}
            data-filter={cat.toLowerCase()}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- Projects Grid -->
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2" id="projects-grid">
      {
        projects.map(project => {
          const { title, description, category, tech, github } = project.data;
          return (
            <div
              class="project-card flex flex-col justify-between rounded-lg border border-border bg-background p-5 transition-all hover:border-accent/60 hover:shadow-sm"
              data-category={category.toLowerCase()}
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="inline-block rounded px-2 py-0.5 text-xs font-semibold bg-accent/10 text-accent">
                    {category}
                  </span>
                  {github && (
                    <a
                      href={github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-muted-foreground hover:text-accent transition-colors"
                      aria-label={`GitHub repository for ${title}`}
                    >
                      <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                      </svg>
                    </a>
                  )}
                </div>
                <h2 class="mt-3 text-lg font-bold text-foreground">
                  {title}
                </h2>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                  {description}
                </p>
              </div>

              <div class="mt-5">
                <div class="flex flex-wrap gap-1.5">
                  {tech.map((t: string) => (
                    <span class="rounded bg-muted/60 px-2 py-0.5 text-xs font-mono text-muted-foreground">
                      {t}
                    </span>
                  ))}
                </div>
                {github && (
                  <div class="mt-4 pt-3 border-t border-border/50">
                    <a
                      href={github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline"
                    >
                      <span>Explore Repository</span>
                      <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  function setupProjectFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");

    filterButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter ?? "all";

        filterButtons.forEach(b => {
          b.classList.remove("active", "bg-accent", "text-accent-foreground", "border-accent");
          b.classList.add("border-border", "hover:bg-muted", "text-muted-foreground");
        });
        btn.classList.add("active", "bg-accent", "text-accent-foreground", "border-accent");
        btn.classList.remove("border-border", "hover:bg-muted", "text-muted-foreground");

        cards.forEach(card => {
          const category = card.dataset.category ?? "";
          if (filter === "all" || category === filter) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  }

  setupProjectFilters();
  document.addEventListener("astro:after-swap", setupProjectFilters);
</script>
