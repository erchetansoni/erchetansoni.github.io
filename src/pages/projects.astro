---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const rawProjects = await getCollection("projects");
const projects = rawProjects.sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const categories = ["All", ...new Set(projects.map(p => p.data.category))];
---

<Layout title={`Featured Projects | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="shell my-8 space-y-10">
    <!-- Header -->
    <div class="space-y-3 pb-6 border-b border-line">
      <span class="section-kicker">02 / Portfolio</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink">
        Technical Projects &amp; <em class="font-serif italic font-normal text-violet">Open-Source.</em>
      </h1>
      <p class="text-sm sm:text-base text-muted max-w-2xl leading-relaxed">
        Production-tested infrastructure automation, container orchestration systems, resilience testing blueprints, and microservices tooling.
      </p>

      <!-- Category Filter Pills -->
      <div class="pt-4 flex flex-wrap gap-2" id="project-filters">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              class:list={[
                "filter-btn px-4 py-1.5 rounded-full text-xs font-semibold transition-all border",
                idx === 0
                  ? "active bg-violet text-white border-violet shadow-sm"
                  : "border-line bg-paper-deep text-muted hover:text-ink hover:border-line-strong",
              ]}
              data-filter={cat.toLowerCase()}
            >
              {cat}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Projects Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
      {
        projects.map((project, idx) => {
          const { title, description, category, tech, github, link } = project.data;
          const accents = ["accent-violet", "accent-teal", "accent-orange", "accent-amber"];
          const accentClass = accents[idx % accents.length];

          return (
            <article
              class={`project-card bento-card ${accentClass} flex flex-col justify-between`}
              data-category={category.toLowerCase()}
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between text-xs font-mono">
                  <span class="font-bold text-violet">0{idx + 1}</span>
                  <span class="pill-badge">{category}</span>
                </div>

                <h2 class="text-xl font-bold text-ink">
                  {title}
                </h2>

                <p class="text-sm text-muted leading-relaxed">
                  {description}
                </p>

                <div class="flex flex-wrap gap-1.5 pt-2">
                  {tech.map((t: string) => (
                    <span class="px-2 py-0.5 rounded-md bg-paper border border-line text-[11px] font-mono text-muted">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-xs font-semibold">
                {github ? (
                  <a
                    href={github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-violet hover:underline inline-flex items-center gap-1.5"
                  >
                    <span>Explore Repository</span>
                    <span>↗</span>
                  </a>
                ) : (
                  <span class="text-muted">Enterprise Blueprint</span>
                )}

                {link && (
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-teal hover:underline inline-flex items-center gap-1.5"
                  >
                    <span>Live Preview</span>
                    <span>↗</span>
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function setupProjectFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");

    filterButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter ?? "all";

        filterButtons.forEach(b => {
          b.classList.remove("active", "bg-violet", "text-white", "border-violet", "shadow-sm");
          b.classList.add("border-line", "bg-paper-deep", "text-muted");
        });
        btn.classList.add("active", "bg-violet", "text-white", "border-violet", "shadow-sm");
        btn.classList.remove("border-line", "bg-paper-deep", "text-muted");

        cards.forEach(card => {
          const category = card.dataset.category ?? "";
          if (filter === "all" || category === filter) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  }

  setupProjectFilters();
  document.addEventListener("astro:after-swap", setupProjectFilters);
</script>
